# Copy to .env for local use. Never put real keys in this example file.
# Without a key the app uses explicitly labeled mock mode.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=
# For local development only; Ollama must already be running locally.
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# RATE_LIMIT_PER_MIN=30
# For local testing only, opt out of authentication explicitly. Never use on a public site.
# AUTH_PROVIDER=off
# For Google sign-in, first configure a Firebase project and Google provider.
# The Firebase web API key is public client configuration; never put OpenAI keys there.
# AUTH_PROVIDER=firebase
# FIREBASE_PROJECT_ID=
# FIREBASE_WEB_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_APP_ID=
# Optional temporary anonymous organizer /api/chat access. Disabled by default.
# Requires Firebase auth above and an explicit future UTC expiration. Limits are
# best-effort per process, reset on restart, and do not guarantee a billing cap.
# Expiry stops future anonymous access; it does not delete stored test chats.
# ORGANIZER_EVAL_ENABLED=true
# ORGANIZER_EVAL_EXPIRES_AT=YYYY-MM-DDTHH:MM:SSZ
# ORGANIZER_EVAL_MAX_REQUESTS=300
# ORGANIZER_EVAL_PER_IP_PER_MIN=30
